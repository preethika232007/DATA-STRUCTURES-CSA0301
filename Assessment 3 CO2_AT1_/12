#include <stdio.h>

int linearSearch(int arr[], int n, int key) {
    int i;

    for (i = 0; i < n; i++)
        if (arr[i] == key)
            return i;

    return -1;
}

int binarySearch(int arr[], int n, int key) {
    int low = 0, high = n - 1, mid;

    while (low <= high) {
        mid = (low + high) / 2;

        if (arr[mid] == key)
            return mid;

        if (key < arr[mid])
            high = mid - 1;
        else
            low = mid + 1;
    }

    return -1;
}

int main() {
    int arr[100], n, key, sorted, queries;
    int i, pos;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter elements: ");
    for (i = 0; i < n; i++)
        scanf("%d", &arr[i]);

    printf("Is data sorted? (1-Yes / 0-No): ");
    scanf("%d", &sorted);

    printf("Enter query frequency: ");
    scanf("%d", &queries);

    printf("Enter key: ");
    scanf("%d", &key);

    if (sorted && (n > 10 || queries > 5)) {
        printf("Using Binary Search\n");
        pos = binarySearch(arr, n, key);
    } else {
        printf("Using Linear Search\n");
        pos = linearSearch(arr, n, key);
    }

    if (pos != -1)
        printf("Element found at position %d\n", pos + 1);
    else
        printf("Element not found\n");

    return 0;
}
