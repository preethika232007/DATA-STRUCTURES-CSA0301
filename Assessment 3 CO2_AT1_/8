#include <stdio.h>
#define SIZE 5

int queue[SIZE];
int front = -1, rear = -1;

void enqueue(int value) {
    if (rear == SIZE - 1) {
        printf("Queue Overflow: %d\n", value);
        return;
    }

    if (front == -1)
        front = 0;

    queue[++rear] = value;
}

void dequeue() {
    if (front == -1 || front > rear) {
        printf("Queue Underflow\n");
        return;
    }

    printf("Deleted: %d\n", queue[front++]);

    if (front > rear)
        front = rear = -1;
}

int main() {
    enqueue(21);
    enqueue(67);
    enqueue(89);
    dequeue();
    enqueue(15);
    enqueue(30);
    enqueue(52);
    dequeue();
    dequeue();
    dequeue();
    dequeue();

    return 0;
}
