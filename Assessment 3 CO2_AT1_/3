#include <stdio.h>
#define SIZE 5

int queue[SIZE];
int front = -1, rear = -1;

void enqueue(int value) {
    if ((rear + 1) % SIZE == front) {
        printf("Queue Overflow\n");
        return;
    }

    if (front == -1)
        front = 0;

    rear = (rear + 1) % SIZE;
    queue[rear] = value;
}

void dequeue() {
    if (front == -1) {
        printf("Queue Underflow\n");
        return;
    }

    printf("Deleted: %d\n", queue[front]);

    if (front == rear) {
        front = rear = -1;
    } else {
        front = (front + 1) % SIZE;
    }
}

int main() {
    enqueue(20);
    enqueue(10);
    enqueue(30);
    dequeue();
    enqueue(80);
    dequeue();
    enqueue(90);
    enqueue(100);
    dequeue();
    dequeue();
    enqueue(60);
    enqueue(90);

    printf("\nFinal Front = %d\n", queue[front]);
    printf("Front Position = %d\n", front);

    printf("Final Rear = %d\n", queue[rear]);
    printf("Rear Position = %d\n", rear);

    return 0;
}
